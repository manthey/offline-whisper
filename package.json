  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "nyc": "^18.0.0",
    "obsidian": "^1.7.2",
    "obsidian-test-mocks": "^3.3.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "v8-to-istanbul": "^9.3.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.0"
  }
}
